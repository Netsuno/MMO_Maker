<UserControl x:Class="Frog.Editor.Panels.LayersProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="clr-namespace:Frog.Editor.Panels"
             Background="#FF282B32">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF465058" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3F4A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFEBEEF5" />

        <Style TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="#FF32353E" />
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="BorderBrush" Value="#FF585C68" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#FF202228" />
            <Setter Property="Foreground" Value="#FF949BAA" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#FF585C68" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#FF202228"
                Padding="12,0,8,0">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FFEBEEF5"
                           Text="COUCHES — ordre de dessin" />
                <Border Height="3"
                        VerticalAlignment="Bottom"
                        Background="#FF64BEFF" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Background="#FF32353E"
                BorderBrush="#FF585C68"
                BorderThickness="1">
            <ListView x:Name="LayersListView"
                      SelectionMode="Single"
                      MouseDoubleClick="LayersListView_OnMouseDoubleClick"
                      SelectionChanged="LayersListView_OnSelectionChanged">
                <ListView.ContextMenu>
                    <ContextMenu Background="#FF32353E" Foreground="#FFEBEEF5">
                        <MenuItem Header="Ajouter couche" Click="MenuAddLayer_Click" />
                        <MenuItem Header="Supprimer couche" Click="MenuRemoveLayer_Click" />
                        <MenuItem Header="Renommer l’affichage…" Click="MenuRenameLayer_Click" />
                        <MenuItem Header="Type moteur (Ground, Mask…)…" Click="MenuChangeEngineType_Click" />
                        <MenuItem Header="Verrouiller / déverrouiller" Click="MenuToggleLock_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40" Header=" ">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type panels:LayerListRow}">
                                    <CheckBox Width="22"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Visible, Mode=OneWay}"
                                              Click="LayerVisibleCheckBox_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="130"
                                        DisplayMemberBinding="{Binding Display}"
                                        Header="Affichage" />
                        <GridViewColumn Width="95"
                                        DisplayMemberBinding="{Binding EngineType}"
                                        Header="Type moteur" />
                        <GridViewColumn Width="52"
                                        DisplayMemberBinding="{Binding LockLabel}"
                                        Header="Verrou" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
