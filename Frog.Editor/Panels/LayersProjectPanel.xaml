<UserControl x:Class="Frog.Editor.Panels.LayersProjectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="clr-namespace:Frog.Editor.Panels"
             Background="#FF282B32">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF465058" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3F4A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFEBEEF5" />

        <Style TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="#FF32353E" />
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="BorderBrush" Value="#FF585C68" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="LayerEyeCheck" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Viewbox Width="22"
                                 Height="14"
                                 Stretch="Uniform"
                                 SnapsToDevicePixels="True"
                                 ToolTip="{TemplateBinding ToolTip}">
                            <Canvas Width="22" Height="16">
                                <Path x:Name="Eye"
                                      Data="M1,8 C5,2.5 17,2.5 21,8 C17,13.5 5,13.5 1,8 Z"
                                      Stroke="#FF64BEFF"
                                      StrokeThickness="1.3"
                                      Fill="#FF202228" />
                                <Ellipse x:Name="Pupil"
                                         Canvas.Left="8"
                                         Canvas.Top="5"
                                         Width="6"
                                         Height="6"
                                         Fill="#FF64BEFF" />
                                <Path x:Name="Slash"
                                      Data="M2,14 L20,2"
                                      Stroke="#FF949BAA"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Canvas>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Pupil" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Eye" Property="Stroke" Value="#FF949BAA" />
                                <Setter TargetName="Eye" Property="Fill" Value="#FF202228" />
                                <Setter TargetName="Slash" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Slash" Property="Stroke" Value="#FF949BAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <GridViewRowPresenter VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"
                                                      Columns="{TemplateBinding GridView.ColumnCollection}" />
                                <Border x:Name="Accent"
                                        Width="4"
                                        HorizontalAlignment="Left"
                                        Background="Transparent" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF3A3F4A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF1A3D58" />
                                <Setter TargetName="Accent" Property="Background" Value="#FF64BEFF" />
                                <Setter TargetName="Accent" Property="Width" Value="6" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="#FF163044" />
                                <Setter TargetName="Accent" Property="Background" Value="#FF64BEFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visible}" Value="False">
                    <Setter Property="Opacity" Value="0.62" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#FF202228" />
            <Setter Property="Foreground" Value="#FF949BAA" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#FF585C68" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#FF202228"
                Padding="12,4,8,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFEBEEF5"
                               Text="COUCHES" />
                    <TextBlock Margin="0,1,0,0"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#FF949BAA"
                               Text="Dessus en haut · la ligne marquée est peinte" />
                </StackPanel>
                <Border Height="3"
                        VerticalAlignment="Bottom"
                        Background="#FF64BEFF" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Background="#FF32353E"
                BorderBrush="#FF585C68"
                BorderThickness="1">
            <ListView x:Name="LayersListView"
                      SelectionMode="Single"
                      MouseDoubleClick="LayersListView_OnMouseDoubleClick"
                      SelectionChanged="LayersListView_OnSelectionChanged">
                <ListView.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="#FFEBEEF5" />
                    </Style>
                </ListView.Resources>
                <ListView.ContextMenu>
                    <ContextMenu Background="#FF32353E" Foreground="#FFEBEEF5">
                        <MenuItem Header="Ajouter une couche" Click="MenuAddLayer_Click" />
                        <MenuItem Header="Supprimer la couche" Click="MenuRemoveLayer_Click" />
                        <MenuItem Header="Renommer…" Click="MenuRenameLayer_Click" />
                        <MenuItem Header="Changer le type (Sol, Masque…)…" Click="MenuChangeEngineType_Click" />
                        <MenuItem Header="Verrouiller ou rendre éditable" Click="MenuToggleLock_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.Header>
                                <TextBlock Text="Vue"
                                           ToolTip="Œil ouvert = couche visible. Œil barré = masquée." />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type panels:LayerListRow}">
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource LayerEyeCheck}"
                                              ToolTip="{Binding VisibilityHint}"
                                              IsChecked="{Binding Visible, Mode=OneWay}"
                                              Click="LayerVisibleCheckBox_Click" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="210" Header="Nom">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type panels:LayerListRow}">
                                    <StackPanel Margin="2,3">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FF64BEFF"
                                                       Text="peinture">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                                                         Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Display}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="#FFEBEEF5" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                                                         Value="True">
                                                                <Setter Property="Foreground" Value="#FF64BEFF" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="10"
                                                   Foreground="#FF949BAA"
                                                   Text="{Binding OrderHint}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="92"
                                        DisplayMemberBinding="{Binding LockLabel}"
                                        Header="Édition" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
