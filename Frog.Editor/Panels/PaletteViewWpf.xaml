<UserControl x:Class="Frog.Editor.Panels.PaletteViewWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF34383F"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             MinHeight="80">
    <Border BorderBrush="#FF585C68"
            BorderThickness="1"
            Margin="6,2,6,8"
            VerticalAlignment="Stretch">
        <ScrollViewer x:Name="Scroller"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <Canvas x:Name="Sheet"
                    Background="#FF34383F"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonDown="Sheet_OnMouseLeftButtonDown"
                    MouseMove="Sheet_OnMouseMove"
                    MouseLeftButtonUp="Sheet_OnMouseLeftButtonUp"
                    MouseLeave="Sheet_OnMouseLeave">
                <Image x:Name="TilesetImg"
                       Stretch="None"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="GridOverlay" IsHitTestVisible="False" />
                <Rectangle x:Name="SelectionRect"
                           Stroke="#FFFFB648"
                           StrokeThickness="2"
                           Fill="Transparent"
                           IsHitTestVisible="False" />
                <Rectangle x:Name="DragPreviewRect"
                           Stroke="#FFDC78FF"
                           StrokeThickness="2"
                           StrokeDashArray="4 2"
                           Fill="Transparent"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />
            </Canvas>
        </ScrollViewer>
    </Border>
</UserControl>
