<UserControl x:Class="Frog.Editor.Panels.EditorLeftToolsWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF282B32">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF585C68" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF465058" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3F4A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF949BAA" />

        <!-- Gabarit dédié : le champ fermé n’utilise plus le ToggleButton Aero (fond clair). -->
        <Style x:Key="EditorSidebarComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FF32353E" />
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="BorderBrush" Value="#FF585C68" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF32353E" />
                        <Setter Property="Foreground" Value="#FFEBEEF5" />
                        <Setter Property="Padding" Value="8,6" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FF465058" />
                                <Setter Property="Foreground" Value="#FFEBEEF5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF465058" />
                                <Setter Property="Foreground" Value="#FFEBEEF5" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ClosedBorder}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FF32353E"
                                        BorderBrush="#FF585C68"
                                        BorderThickness="1"
                                        Margin="0,1,0,0">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <Border x:Name="ClosedBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    MinHeight="{TemplateBinding MinHeight}">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Width="10"
                                          Height="6"
                                          Data="M 0 0 L 5 6 L 10 0 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False" />
                                    <ToggleButton Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Width="0"
                                     Height="0"
                                     Visibility="Collapsed"
                                     Margin="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="12,14,14,10">
        <TextBlock Text="OUTIL"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Outil"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboTool"
                      Grid.Column="1"
                      Style="{StaticResource EditorSidebarComboBox}"
                      MinHeight="28"
                      SelectionChanged="ComboTool_OnSelectionChanged" />
        </Grid>
        <TextBlock Text="TYPE DE TUILE"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Type"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboTileType"
                      Grid.Column="1"
                      Style="{StaticResource EditorSidebarComboBox}"
                      MinHeight="28"
                      SelectionChanged="ComboTileType_OnSelectionChanged" />
        </Grid>
    </StackPanel>
</UserControl>
