<UserControl x:Class="Frog.Editor.Panels.EditorLeftToolsWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF282B32">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFEBEEF5" />
    </UserControl.Resources>
    <StackPanel Margin="12,14,14,10">
        <TextBlock Text="OUTIL"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Outil"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboTool"
                      Grid.Column="1"
                      MinHeight="28"
                      SelectionChanged="ComboTool_OnSelectionChanged" />
        </Grid>
        <TextBlock Text="TYPE DE TUILE"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Type"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboTileType"
                      Grid.Column="1"
                      MinHeight="28"
                      SelectionChanged="ComboTileType_OnSelectionChanged" />
        </Grid>
    </StackPanel>
</UserControl>
