<UserControl x:Class="Frog.Editor.Panels.EditorLeftToolsWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:Frog.Editor.Enums"
             Background="#FF282B32">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF32353E" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF585C68" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF465058" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3F4A" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFEBEEF5" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF949BAA" />

        <!-- Gabarit dédié : le champ fermé n’utilise plus le ToggleButton Aero (fond clair). -->
        <Style x:Key="EditorSidebarComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FF32353E" />
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="BorderBrush" Value="#FF585C68" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#FF32353E" />
                        <Setter Property="Foreground" Value="#FFEBEEF5" />
                        <Setter Property="Padding" Value="8,6" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FF465058" />
                                <Setter Property="Foreground" Value="#FFEBEEF5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF465058" />
                                <Setter Property="Foreground" Value="#FFEBEEF5" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ClosedBorder}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FF32353E"
                                        BorderBrush="#FF585C68"
                                        BorderThickness="1"
                                        Margin="0,1,0,0">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <Border x:Name="ClosedBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    MinHeight="{TemplateBinding MinHeight}">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Width="10"
                                          Height="6"
                                          Data="M 0 0 L 5 6 L 10 0 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False" />
                                    <ToggleButton Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Width="0"
                                     Height="0"
                                     Visibility="Collapsed"
                                     Margin="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorPrefabListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFEBEEF5" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF3A3F4A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF465058" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="12,14,14,10">
        <TextBlock Text="OUTIL"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Outil"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboTool"
                      Grid.Column="1"
                      Style="{StaticResource EditorSidebarComboBox}"
                      MinHeight="28"
                      SelectionChanged="ComboTool_OnSelectionChanged" />
        </Grid>
        <TextBlock x:Name="DrawToolHint"
                   Text="Pinceau (B) · clic ou glisser pour peindre la tuile"
                   TextWrapping="Wrap"
                   Foreground="#FF64BEFF"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Margin="8,0,2,6" />
        <UniformGrid Columns="2" Margin="2,0,2,8">
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF32353E" />
                    <Setter Property="Foreground" Value="#FFEBEEF5" />
                    <Setter Property="BorderBrush" Value="#FF585C68" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF3A3F4A" />
                            <Setter Property="BorderBrush" Value="#FF64BEFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Resources>
            <Button x:Name="BtnToolBrush"
                    Content="Pinceau"
                    Tag="Brush"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Pinceau (B) — peindre la tuile"
                    Click="OnDrawToolClick" />
            <Button x:Name="BtnToolEraser"
                    Content="Gomme"
                    Tag="Eraser"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Gomme (E) — efface le tampon sur la couche active visible et déverrouillée. Les autres couches restent."
                    Click="OnDrawToolClick" />
            <Button x:Name="BtnToolFill"
                    Content="Remplissage"
                    Tag="Fill"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Remplissage (F) — pot de peinture, 4 directions. Clic droit ou tuile vide : efface la région."
                    Click="OnDrawToolClick" />
            <Button x:Name="BtnToolRectangle"
                    Content="Rectangle"
                    Tag="Rectangle"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Rectangle (R) — plein par défaut. Maj ou case Contour : bord seulement. Case Ellipse : ellipse inscrite. Couche active visible et déverrouillée."
                    Click="OnDrawToolClick" />
            <Button x:Name="BtnToolLine"
                    Content="Ligne"
                    Tag="Line"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Ligne (L) — trait d'une tuile. Maj = axe."
                    Click="OnDrawToolClick" />
            <Button x:Name="BtnToolSelection"
                    Content="Sélection"
                    Tag="Selection"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Sélection (M) — rectangle. Ctrl+C/X/V copie toutes les couches, Ctrl+Maj = couche active."
                    Click="OnDrawToolClick" />
            <Button x:Name="BtnToolPlace"
                    Content="Entités"
                    Tag="Place"
                    Margin="2"
                    Padding="8,5"
                    ToolTip="Entités (N) — poser une apparition, un PNJ ou un objet. Propriétés dans la colonne de droite. Clic droit retire."
                    Click="OnDrawToolClick" />
        </UniformGrid>
        <StackPanel x:Name="FillOptionsPanel" Visibility="Collapsed" Margin="8,0,2,8">
            <CheckBox x:Name="ChkFillVisibleLayers"
                      Content="Couches visibles déverrouillées"
                      Foreground="#FFEBEEF5"
                      FontFamily="Segoe UI"
                      FontSize="12"
                      Margin="0,2,0,4"
                      IsChecked="False"
                      ToolTip="Défaut : couche active seulement. Cochez, ou Ctrl+clic, pour peindre la même région sur les couches visibles et déverrouillées. La couche Attributs n’est peinte que si elle est active. Les couches masquées ou verrouillées sont ignorées."
                      Checked="OnFillOptionChanged"
                      Unchecked="OnFillOptionChanged" />
            <CheckBox x:Name="ChkFillRespectAttrs"
                      Content="Respecter collisions / attrs"
                      Foreground="#FFEBEEF5"
                      FontFamily="Segoe UI"
                      FontSize="12"
                      Margin="0,0,0,2"
                      IsChecked="False"
                      ToolTip="N’écrase pas une case dont le blocage, le warp, la ressource, le script ou la tuile de la couche Attributs diffère de la case cliquée."
                      Checked="OnFillOptionChanged"
                      Unchecked="OnFillOptionChanged" />
        </StackPanel>
        <StackPanel x:Name="RectangleOptionsPanel" Visibility="Collapsed" Margin="8,0,2,8">
            <CheckBox x:Name="ChkRectangleOutline"
                      Content="Contour seulement"
                      Foreground="#FFEBEEF5"
                      FontFamily="Segoe UI"
                      FontSize="12"
                      Margin="0,2,0,4"
                      IsChecked="False"
                      ToolTip="Défaut : rectangle plein. Cochez, ou maintenez Maj pendant le tracé, pour ne peindre que le bord. La couche active doit être visible et déverrouillée."
                      Checked="OnRectangleOptionChanged"
                      Unchecked="OnRectangleOptionChanged" />
            <CheckBox x:Name="ChkRectangleEllipse"
                      Content="Ellipse"
                      Foreground="#FFEBEEF5"
                      FontFamily="Segoe UI"
                      FontSize="12"
                      Margin="0,0,0,2"
                      IsChecked="False"
                      ToolTip="Ellipse inscrite dans le rectangle tracé. Décochez pour un rectangle. Le contour s’applique aussi à l’ellipse."
                      Checked="OnRectangleOptionChanged"
                      Unchecked="OnRectangleOptionChanged" />
        </StackPanel>
        <TextBlock Text="{x:Static enums:EditorToolHotkeys.PaletteHint}"
                   TextWrapping="Wrap"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Margin="8,0,2,4" />
        <TextBlock Text="{x:Static enums:EditorToolHotkeys.SelectionHint}"
                   TextWrapping="Wrap"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Margin="8,0,2,8" />
        <Button Content="Pipette tuile (I)"
                Margin="2,0,2,8"
                Padding="8,5"
                Background="#FF32353E"
                Foreground="#FFB4D4A8"
                BorderBrush="#FF585C68"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnPipetteClick" />
        <Button Content="Placer le départ (D)"
                Margin="2,0,2,8"
                Padding="8,5"
                Background="#FF32353E"
                Foreground="#FF64BEFF"
                BorderBrush="#FF585C68"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnPlaceSpawnClick" />
        <TextBlock x:Name="SpawnStatus"
                   Text="Départ playtest : non défini"
                   Foreground="#FF64BEFF"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Margin="8,0,2,12" />
        <TextBlock Text="PREFAB"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,4">
            <TextBox x:Name="PrefabFilter"
                     MinHeight="28"
                     Padding="8,4"
                     Background="#FF32353E"
                     Foreground="#FFEBEEF5"
                     BorderBrush="#FF585C68"
                     BorderThickness="1"
                     CaretBrush="#FFEBEEF5"
                     SelectionBrush="#FF465058"
                     FontFamily="Segoe UI"
                     FontSize="12"
                     ToolTip="Filtrer par nom affiché ou identifiant"
                     TextChanged="PrefabFilter_OnTextChanged" />
            <TextBlock x:Name="PrefabFilterHint"
                       Text="Rechercher (nom ou id)"
                       IsHitTestVisible="False"
                       Margin="10,0,28,0"
                       VerticalAlignment="Center"
                       Foreground="#FF6E7584"
                       FontFamily="Segoe UI"
                       FontSize="12" />
        </Grid>
        <TextBlock x:Name="PrefabMatchCount"
                   Text=""
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Margin="8,0,2,4" />
        <ListBox x:Name="ListPrefabs"
                 Height="88"
                 Margin="2,0,2,2"
                 Background="#FF32353E"
                 Foreground="#FFEBEEF5"
                 BorderBrush="#FF585C68"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource EditorPrefabListItem}"
                 SelectionChanged="ListPrefabs_OnSelectionChanged"
                 PreviewMouseLeftButtonUp="ListPrefabs_OnPreviewMouseLeftButtonUp">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="22"
                               Height="22"
                               Margin="0,0,8,0"
                               Stretch="Uniform"
                               Source="{Binding Thumbnail}"
                               Visibility="{Binding ThumbnailVisibility}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       Foreground="#FFEBEEF5"
                                       FontFamily="Segoe UI"
                                       FontSize="12" />
                            <TextBlock Text="{Binding Id}"
                                       Foreground="#FF949BAA"
                                       FontFamily="Segoe UI"
                                       FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="PrefabFilterEmpty"
                   Text="Aucun prefab ne correspond."
                   Visibility="Collapsed"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Margin="8,2,2,6" />
        <Grid Margin="2,6,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Facing"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboPrefabFacing"
                      Grid.Column="1"
                      Style="{StaticResource EditorSidebarComboBox}"
                      MinHeight="28"
                      SelectionChanged="ComboPrefabFacing_OnSelectionChanged" />
        </Grid>
        <Grid Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PrefabPreviewHost"
                    Width="40"
                    Height="40"
                    Margin="6,0,8,0"
                    Visibility="Collapsed"
                    Background="#FF32353E"
                    BorderBrush="#FF585C68"
                    BorderThickness="1">
                <Image x:Name="PrefabPreview" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PrefabSelectedName"
                           Text="—"
                           TextWrapping="Wrap"
                           Foreground="#FFE8B86D"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="PrefabSelectedMeta"
                           Text=""
                           TextWrapping="Wrap"
                           Foreground="#FF949BAA"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PrefabStatus"
                   Text="P pour placer"
                   TextWrapping="Wrap"
                   Foreground="#FFE8B86D"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Margin="8,0,2,8" />
        <Button x:Name="BtnDuplicatePrefab"
                Content="Dupliquer le dernier posé"
                Margin="2,0,2,4"
                Padding="8,5"
                IsEnabled="False"
                Background="#FF32353E"
                Foreground="#FFE8B86D"
                BorderBrush="#FF585C68"
                BorderThickness="1"
                Cursor="Hand"
                ToolTip="Pose une copie du dernier objet, décalée de son empreinte."
                Click="OnDuplicatePrefabClick" />
        <Button x:Name="BtnPlacePrefab"
                Content="Placer un objet (P)"
                Margin="2,0,2,4"
                Padding="8,5"
                Background="#FF32353E"
                Foreground="#FFE8B86D"
                BorderBrush="#FF585C68"
                BorderThickness="1"
                Cursor="Hand"
                Click="OnPlacePrefabClick" />
        <TextBlock Text="Pipette I / Alt+clic · glisser pour déplacer"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Margin="8,0,2,8" />
        <TextBlock Text="TYPE DE TUILE"
                   Foreground="#FF949BAA"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Margin="2,0,0,8" />
        <Grid Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Type"
                       VerticalAlignment="Center"
                       Foreground="#FF949BAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       Margin="6,0,4,0" />
            <ComboBox x:Name="ComboTileType"
                      Grid.Column="1"
                      Style="{StaticResource EditorSidebarComboBox}"
                      MinHeight="28"
                      SelectionChanged="ComboTileType_OnSelectionChanged" />
        </Grid>
    </StackPanel>
</UserControl>
