<Window x:Class="Frog.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Frog.Editor"
        xmlns:maps="clr-namespace:Frog.Core.Maps;assembly=Frog.Core"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="MMO Maker — Éditeur"
        Width="1200"
        Height="780"
        MinWidth="1280"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FF202228">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.CmdNewMap}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.CmdOpenMap}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.CmdSaveMap}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.CmdUndo}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.CmdRedo}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:MainWindow.CmdZoomIn}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:MainWindow.CmdZoomOut}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static local:MainWindow.CmdZoomIn}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static local:MainWindow.CmdZoomOut}" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.CmdRefreshCatalog}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="#FF202228"
              Foreground="#FFEBEEF5"
              FontFamily="Segoe UI"
              FontSize="12"
              ItemContainerStyle="{StaticResource EditorMenuTopLevelItem}">
            <Menu.Resources>
                <Style TargetType="{x:Type Separator}">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="6,4,6,4" />
                    <Setter Property="Background" Value="#FF505666" />
                </Style>
            </Menu.Resources>
            <MenuItem Header="_Fichier" ItemContainerStyle="{StaticResource EditorMenuDropdownItem}">
                <MenuItem Header="Nouvelle carte…"
                          Command="{x:Static local:MainWindow.CmdNewMap}"
                          InputGestureText="Ctrl+N" />
                <MenuItem Header="Ouvrir fichier…"
                          Command="{x:Static local:MainWindow.CmdOpenMap}"
                          InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="Enregistrer (PostgreSQL)"
                          Command="{x:Static local:MainWindow.CmdSaveMap}"
                          InputGestureText="Ctrl+S" />
                <MenuItem Header="Publier (PostgreSQL)…"
                          Command="{x:Static local:MainWindow.CmdPublishMap}" />
                <MenuItem Header="Exporter fichier .fmap…"
                          Command="{x:Static local:MainWindow.CmdExportMap}" />
                <MenuItem Header="Lancer le client…"
                          Command="{x:Static local:MainWindow.CmdLaunchFrogClient}" />
                <MenuItem Header="Tester (playtest)…"
                          Command="{x:Static local:MainWindow.CmdPlaytest}"
                          InputGestureText="Ctrl+F5"
                          ToolTip="Enregistre la carte si elle a changé, puis lance serveur et client frères sur cette carte. Le test suivant relit les tuiles, PNJ et objets sans republier le client." />
                <MenuItem Header="Arrêter le test"
                          Command="{x:Static local:MainWindow.CmdStopPlaytest}" />
                <Separator />
                <MenuItem Header="_Quitter" Command="{x:Static local:MainWindow.CmdQuit}" />
            </MenuItem>
            <MenuItem Header="_Édition" ItemContainerStyle="{StaticResource EditorMenuDropdownItem}">
                <MenuItem Header="_Annuler"
                          Command="{x:Static local:MainWindow.CmdUndo}"
                          InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Rétablir"
                          Command="{x:Static local:MainWindow.CmdRedo}"
                          InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Copier la zone (toutes les couches)"
                          Command="{x:Static local:MainWindow.CmdCopySelection}"
                          InputGestureText="Ctrl+C" />
                <MenuItem Header="Couper la zone (toutes les couches)"
                          Command="{x:Static local:MainWindow.CmdCutSelection}"
                          InputGestureText="Ctrl+X" />
                <MenuItem Header="Coller la zone (toutes les couches)"
                          Command="{x:Static local:MainWindow.CmdPasteSelection}"
                          InputGestureText="Ctrl+V" />
                <MenuItem Header="Copier la zone (couche active)"
                          Command="{x:Static local:MainWindow.CmdCopySelection}"
                          CommandParameter="layer"
                          InputGestureText="Ctrl+Maj+C" />
                <MenuItem Header="Couper la zone (couche active)"
                          Command="{x:Static local:MainWindow.CmdCutSelection}"
                          CommandParameter="layer"
                          InputGestureText="Ctrl+Maj+X" />
                <MenuItem Header="Coller la zone (couche active)"
                          Command="{x:Static local:MainWindow.CmdPasteSelection}"
                          CommandParameter="layer"
                          InputGestureText="Ctrl+Maj+V" />
                <Separator />
                <MenuItem Header="Rotation 90°"
                          Command="{x:Static local:MainWindow.CmdRotateSelection}"
                          InputGestureText="Q" />
                <MenuItem Header="Miroir horizontal"
                          Command="{x:Static local:MainWindow.CmdMirrorHorizontal}"
                          InputGestureText="H" />
                <MenuItem Header="Miroir vertical"
                          Command="{x:Static local:MainWindow.CmdMirrorVertical}"
                          InputGestureText="V" />
                <MenuItem Header="Pipette tuile"
                          Command="{x:Static local:MainWindow.CmdTilePipette}"
                          InputGestureText="I" />
                <MenuItem Header="Dupliquer l’objet"
                          Command="{x:Static local:MainWindow.CmdDuplicatePrefab}"
                          InputGestureText="Ctrl+D" />
                <Separator />
                <MenuItem Header="Enregistrer la sélection comme modèle…"
                          Command="{x:Static local:MainWindow.CmdSaveSelectionTemplate}" />
                <MenuItem Header="Enregistrer la carte comme modèle…"
                          Command="{x:Static local:MainWindow.CmdSaveMapTemplate}" />
                <MenuItem Header="Poser un modèle…"
                          Command="{x:Static local:MainWindow.CmdStampTemplate}" />
            </MenuItem>
            <MenuItem Header="_Ressources" ItemContainerStyle="{StaticResource EditorMenuDropdownItem}">
                <MenuItem Header="Données de jeu…" Command="{x:Static local:MainWindow.CmdGameData}" />
                <MenuItem Header="Événements communs…" Command="{x:Static local:MainWindow.CmdBrowseCommonEvents}" />
                <MenuItem Header="Charger une image tuiles…" Command="{x:Static local:MainWindow.CmdOpenTileset}" />
                <MenuItem Header="Importer une feuille TileAsset…" Command="{x:Static local:MainWindow.CmdImportTileAssetSheet}" />
                <Separator />
                <MenuItem Header="Animer la sélection de tuiles" Command="{x:Static local:MainWindow.CmdMarkTilesAnimated}" />
                <MenuItem Header="Retirer l’animation de la sélection" Command="{x:Static local:MainWindow.CmdClearTilesAnimated}" />
                <MenuItem Header="{x:Static maps:TileAssetFlagLabels.EditMenu}"
                          Command="{x:Static local:MainWindow.CmdEditAutotile}" />
            </MenuItem>
            <MenuItem Header="_Carte" ItemContainerStyle="{StaticResource EditorMenuDropdownItem}">
                <MenuItem Header="Valider la carte…" Command="{x:Static local:MainWindow.CmdValidateMap}" />
                <MenuItem Header="Propriétés de la carte…" Command="{x:Static local:MainWindow.CmdMapProperties}" />
                <MenuItem Header="Taille et décalage…" Command="{x:Static local:MainWindow.CmdMapResizeShift}" />
                <MenuItem Header="Passer cette carte en TileAsset (v6)…" Command="{x:Static local:MainWindow.CmdConvertMapToTileAsset}" />
                <MenuItem Header="Vérifier les transferts…" Command="{x:Static local:MainWindow.CmdShowTransferIssues}" />
                <MenuItem Header="Outil gomme"
                          Command="{x:Static local:MainWindow.CmdEraserTool}"
                          InputGestureText="E" />
                <MenuItem Header="Outil remplissage"
                          Command="{x:Static local:MainWindow.CmdFillTool}"
                          InputGestureText="F" />
                <MenuItem Header="Outil rectangle"
                          Command="{x:Static local:MainWindow.CmdRectangleTool}"
                          InputGestureText="R" />
                <MenuItem Header="Outil ligne"
                          Command="{x:Static local:MainWindow.CmdLineTool}"
                          InputGestureText="L" />
                <MenuItem Header="Outil point de départ"
                          Command="{x:Static local:MainWindow.CmdSpawnTool}"
                          InputGestureText="D" />
                <MenuItem Header="Outil prefab / objet"
                          Command="{x:Static local:MainWindow.CmdPrefabTool}"
                          InputGestureText="P" />
                <MenuItem Header="Outil entités"
                          Command="{x:Static local:MainWindow.CmdPlaceTool}"
                          InputGestureText="N" />
                <MenuItem Header="Outil région"
                          Command="{x:Static local:MainWindow.CmdRegionTool}"
                          InputGestureText="G" />
                <MenuItem Header="Configurer warp sélectionné…" Command="{x:Static local:MainWindow.CmdEditWarp}" />
                <MenuItem Header="Actualiser le catalogue (PostgreSQL / mémoire)"
                          Command="{x:Static local:MainWindow.CmdRefreshCatalog}"
                          InputGestureText="F5" />
                <Separator />
                <MenuItem Header="PNJ rapide…"
                          Command="{x:Static local:MainWindow.CmdQuickTalkingNpc}" />
                <MenuItem Header="Coffre…"
                          Command="{x:Static local:MainWindow.CmdQuickChest}" />
                <MenuItem Header="Porte…"
                          Command="{x:Static local:MainWindow.CmdQuickDoor}" />
                <MenuItem Header="Auberge…"
                          Command="{x:Static local:MainWindow.CmdQuickInn}" />
                <MenuItem Header="Événements carte…"
                          Command="{x:Static local:MainWindow.CmdBrowseMapEvents}" />
                <MenuItem Header="Contenu Phase 8…"
                          Command="{x:Static local:MainWindow.CmdBrowsePhase8Content}" />
                <MenuItem Header="Événements communs…"
                          Command="{x:Static local:MainWindow.CmdBrowseCommonEvents}" />
                <MenuItem Header="Actualiser marqueurs événements"
                          Command="{x:Static local:MainWindow.CmdRefreshMapEventMarkers}" />
            </MenuItem>
            <MenuItem Header="_Affichage" ItemContainerStyle="{StaticResource EditorMenuDropdownItem}">
                <MenuItem Header="Zoom avant"
                          Command="{x:Static local:MainWindow.CmdZoomIn}"
                          InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom arrière"
                          Command="{x:Static local:MainWindow.CmdZoomOut}"
                          InputGestureText="Ctrl+-" />
                <Separator />
                <MenuItem Header="Réinitialiser la vue (zoom 100 %)" Command="{x:Static local:MainWindow.CmdResetView}" />
                <Separator />
                <MenuItem x:Name="MnuShowEventMarkers"
                          Header="Marqueurs événements"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="OnToggleMapEventMarkers" />
                <MenuItem x:Name="MnuShowEventNames"
                          Header="Afficher noms des événements"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="OnToggleMapEventNames" />
                <MenuItem x:Name="MnuAnimPreview"
                          Header="Aperçu des tuiles animées"
                          IsCheckable="True"
                          IsChecked="True"
                          ToolTip="Fait défiler les tuiles animées sur la carte et dans la palette."
                          Click="OnToggleAnimPreview" />
                <MenuItem x:Name="MnuAutotileJoin"
                          Header="{x:Static maps:TileAssetFlagLabels.JoinMenu}"
                          IsCheckable="True"
                          IsChecked="True"
                          ToolTip="En peignant une tuile d’un groupe, les voisins du même groupe prennent le rôle qui correspond (centre, bords, coins)."
                          Click="OnToggleAutotileJoin" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top" Background="#FF2A2E36">
            <ToolBar Background="#FF2A2E36" Band="0" BandIndex="0" ToolBarTray.IsLocked="True">
                <ToolBar.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF2A2E36" />
                        <Setter Property="Foreground" Value="#FFEBEEF5" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ToolBar.Resources>
                <Button Content="&#xE710;"
                        Command="{x:Static local:MainWindow.CmdNewMap}"
                        ToolTip="Nouvelle carte" />
                <Button Content="&#xE8E5;"
                        Command="{x:Static local:MainWindow.CmdOpenMap}"
                        ToolTip="Ouvrir" />
                <Button Content="&#xE74E;"
                        Command="{x:Static local:MainWindow.CmdSaveMap}"
                        ToolTip="Enregistrer" />
                <Separator />
                <Button Content="&#xE7A7;"
                        Command="{x:Static local:MainWindow.CmdUndo}"
                        ToolTip="Annuler" />
                <Button Content="&#xE7A6;"
                        Command="{x:Static local:MainWindow.CmdRedo}"
                        ToolTip="Rétablir" />
                <Separator />
                <Button Content="&#xE8A3;"
                        Command="{x:Static local:MainWindow.CmdZoomIn}"
                        ToolTip="Zoom avant" />
                <Button Content="&#xE71F;"
                        Command="{x:Static local:MainWindow.CmdZoomOut}"
                        ToolTip="Zoom arrière" />
                <Separator />
                <Button Content="&#xE768;"
                        Command="{x:Static local:MainWindow.CmdPlaytest}"
                        ToolTip="Tester (playtest, Ctrl+F5)" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" Background="#FF2E3238">
            <StatusBarItem>
                <TextBlock x:Name="TileStatusText"
                           Text="Tuiles · Pinceau (B) · couche — · (0, 0) · tuile (0, 0) · zoom 100 %"
                           Foreground="#FFEBEEF5"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Tuiles · Pinceau (B) · couche — · (0, 0) · tuile (0, 0) · zoom 100 %" />
            </StatusBarItem>
        </StatusBar>
        <!-- Coque WPF : colonnes et splitters ; îlots WinForms (canevas GDI+, palettes, PropertyGrid). -->
        <Grid x:Name="ShellGrid" Background="#FF202228">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="200" MinWidth="180" MaxWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="ColRight" Width="300" MinWidth="280" MaxWidth="420" />
            </Grid.ColumnDefinitions>
            <wfi:WindowsFormsHost x:Name="HostLeft"
                                  Grid.Column="0"
                                  Margin="0,0,0,0" />
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FF505666"
                          ShowsPreview="False"
                          DragCompleted="OnShellSplitterDragCompleted" />
            <Border Grid.Column="2"
                    Margin="2,4,2,6"
                    BorderBrush="#FF585C68"
                    BorderThickness="1"
                    CornerRadius="0"
                    Background="#FF2E3238">
                <wfi:WindowsFormsHost x:Name="HostCenter" />
            </Border>
            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FF505666"
                          ShowsPreview="False"
                          DragCompleted="OnShellSplitterDragCompleted" />
            <wfi:WindowsFormsHost x:Name="HostRight"
                                  Grid.Column="4"
                                  Margin="0,0,0,0" />
        </Grid>
    </DockPanel>
</Window>
