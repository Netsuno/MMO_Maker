<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Menus WPF lisent encore des clés SystemColors ; on les aligne sur EditorChrome (WinForms). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF202228" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF32353E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFEBEEF5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FF5C82FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF465058" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFEBEEF5" />

    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="#FF202228" />
        <Setter Property="Foreground" Value="#FF949BAA" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
