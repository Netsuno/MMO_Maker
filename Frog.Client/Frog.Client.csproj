<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	<PlatformTarget>x64</PlatformTarget>
    <Version>10.3.0</Version>
    <AssemblyVersion>10.3.0.0</AssemblyVersion>
    <FileVersion>10.3.0.0</FileVersion>
    <InformationalVersion>10.3.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Frog.Editor.WindowsSmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="Config\" />
    <Folder Include="Controls\" />
    <Folder Include="Forms\" />
    <Folder Include="Models\" />
    <Folder Include="Network\" />
    <Folder Include="Services\" />
    <Folder Include="Utils\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frog.Core\Frog.Core.csproj" />
    <ProjectReference Include="..\Frog.Application\Frog.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>