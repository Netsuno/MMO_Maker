{
    "Server": {
        "bindAddress": "127.0.0.1",
        "port": 6000
    },
    "Postgres": {
        "enabled": false,
        "connectionString": "Host=127.0.0.1;Port=5432;Database=frog;Username=postgres;Password=postgres"
    },
    "Sessions": {
        "idleTimeoutSeconds": 300,
        "cleanupIntervalSeconds": 30
    },
    "Persistence": {
        "saveIntervalSeconds": 45
    },
    "Maps": {
        "worldMapPath": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Frog.Server.Network.PacketDispatcher": "Debug"
        },
        "Console": {
            "FormatterName": "json",
            "FormatterOptions": {
                "SingleLine": true,
                "IncludeScopes": true,
                "TimestampFormat": "O",
                "UseUtcTimestamp": true
            }
        }
    }
}
