{
    "Server": {
        "bindAddress": "127.0.0.1",
        "port": 6000,
        "allowNonLoopbackBind": false,
        "tls": {
            "mode": "Off",
            "certificatePath": "",
            "privateKeyPath": "",
            "pfxPath": "",
            "allowCleartextLoopback": false
        }
    },
    "MariaDb": {
        "enabled": false,
        "connectionString": "Server=127.0.0.1;Port=3306;Database=frog;User Id=root;Password=NOT_A_PRODUCTION_SECRET"
    },
    "PostgreSql": {
        "enabled": false,
        "allowInMemoryFallback": false,
        "connectionString": "Host=127.0.0.1;Port=5432;Database=frog;Username=frog;Password=NOT_A_PRODUCTION_SECRET"
    },
    "Sessions": {
        "idleTimeoutSeconds": 300,
        "cleanupIntervalSeconds": 30
    },
    "Persistence": {
        "saveIntervalSeconds": 45
    },
    "Registration": {
        "mode": "Open"
    },
    "Social": {
        "partyMaxMembers": 5,
        "guildMaxMembers": 50,
        "partyInviteSeconds": 60,
        "guildInviteSeconds": 120,
        "friendRequestDays": 7,
        "maxFriends": 100,
        "maxBlocks": 100,
        "maxPendingOutgoing": 3,
        "maxPendingIncoming": 8,
        "reinviteCooldownSeconds": 30,
        "inviteRatePerMinute": 10
    },
    "Maps": {
        "worldMapPath": "",
        "databaseFallbackMapId": 0
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Frog.Server.Network.PacketDispatcher": "Debug"
        },
        "Console": {
            "FormatterName": "simple",
            "FormatterOptions": {
                "SingleLine": false,
                "IncludeScopes": true,
                "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
                "UseUtcTimestamp": true,
                "ColorBehavior": "Enabled"
            }
        }
    }
}
