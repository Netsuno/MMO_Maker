{
    "Server": {
        "bindAddress": "127.0.0.1",
        "port": 6000
    },
    "MariaDb": {
        "enabled": false,
        "connectionString": "Server=127.0.0.1;Port=3306;Database=frog;User Id=root;Password=changeme"
    },
    "Sessions": {
        "idleTimeoutSeconds": 300,
        "cleanupIntervalSeconds": 30
    },
    "Persistence": {
        "saveIntervalSeconds": 45
    },
    "Maps": {
        "worldMapPath": "",
        "databaseFallbackMapId": 0
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Frog.Server.Network.PacketDispatcher": "Debug"
        },
        "Console": {
            "FormatterName": "simple",
            "FormatterOptions": {
                "SingleLine": false,
                "IncludeScopes": true,
                "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
                "UseUtcTimestamp": true,
                "ColorBehavior": "Enabled"
            }
        }
    }
}
