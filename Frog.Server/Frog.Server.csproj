<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Frog.Core\Frog.Core.csproj" />
        <ProjectReference Include="..\Frog.Application\Frog.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.Local.json.example">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Database\schema_frog_mariadb_v1.sql">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
        <PackageReference Include="MySqlConnector" Version="2.4.0" />
    </ItemGroup>

    <Target Name="CopyPostgreSqlAuthBackend" AfterTargets="Build">
        <MSBuild
            Projects="$(MSBuildThisFileDirectory)..\Frog.Persistence.PostgreSql\Frog.Persistence.PostgreSql.csproj"
            Targets="Build"
            Properties="Configuration=$(Configuration)" />
        <Copy
            SourceFiles="$(MSBuildThisFileDirectory)..\Frog.Persistence.PostgreSql\bin\$(Configuration)\net8.0\Frog.Persistence.PostgreSql.dll"
            DestinationFolder="$(OutputPath)"
            SkipUnchangedFiles="true" />
        <Copy
            SourceFiles="$(MSBuildThisFileDirectory)..\Frog.Persistence.PostgreSql\bin\$(Configuration)\net8.0\Frog.Persistence.PostgreSql.pdb"
            DestinationFolder="$(OutputPath)"
            SkipUnchangedFiles="true"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Frog.Persistence.PostgreSql\bin\$(Configuration)\net8.0\Frog.Persistence.PostgreSql.pdb')" />
    </Target>
</Project>
